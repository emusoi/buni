  "decisions": {
    "0311e578": {
      "at": "2026-10-16T22:50:41.802Z",
      "by": "claude",
      "id": "0311e578",
      "text": "What do lists and pickers get from the server? → Summaries; full documents on demand: Every list, picker and count needs names, routes and counts, not layers"
    },
    "14d19414": {
      "at": "2026-10-16T22:50:39.914Z",
      "by": "claude",
      "id": "14d19414",
      "text": "How does the index learn a design changed? → Watch directories, reconcile on failure: Agents and git change files outside the server; directories catch atomic renames"
    },
    "7070598c": {
      "at": "2026-10-16T22:50:38.607Z",
      "by": "claude",
      "id": "7070598c",
      "text": "How should the tab switch to another design? → Switch in the tab, from a snapshot cache: Most of the cost is the reload itself; the server is already warm (16 to 160 ms)"
    }
  },
