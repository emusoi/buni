  "traces": {
    "an-agent-edits-the-core": {
      "id": "an-agent-edits-the-core",
      "index": "a2",
      "name": "An agent edits the core",
      "steps": [
        {
          "action": "core.buni changed: stat, read, parse it once",
          "async": true,
          "from": "file-watcher",
          "ms": 40,
          "to": "project-index",
          "via": "designchanged"
        },
        {
          "action": "Tell the server; it rebuilds the systems of open designs that import the core, and only those",
          "async": true,
          "from": "file-watcher",
          "ms": 20,
          "to": "editor-server",
          "via": "designchanged"
        },
        {
          "action": "Push ProjectDelta and the open design's patch on the tab's one stream",
          "async": true,
          "carries": "project-delta",
          "from": "editor-server",
          "ms": 20,
          "to": "editor-window",
          "via": "get-events"
        }
      ]
    },
    "open-home": {
      "id": "open-home",
      "index": "a4",
      "name": "Open Home",
      "steps": [
        {
          "action": "Ask for the project as summaries",
          "carries": "project-summary",
          "from": "editor-window",
          "ms": 30,
          "to": "editor-server",
          "via": "get-rpc-project"
        },
        {
          "action": "Load each card's thumbnail as a picture, cached by version, instead of a live page per card",
          "async": true,
          "from": "editor-window",
          "ms": 40,
          "to": "editor-server",
          "via": "get-thumbs-file-page"
        }
      ]
    },
    "open-the-editor-on-a-1-mb-design": {
      "id": "open-the-editor-on-a-1-mb-design",
      "index": "a1",
      "name": "Open the editor on a 1 MB design",
      "steps": [
        {
          "action": "Ask for the open design's snapshot",
          "carries": "snapshot",
          "from": "editor-window",
          "ms": 120,
          "to": "editor-server",
          "via": "get-rpc-snapshot"
        },
        {
          "action": "Ask for the project as summaries, a few KB per design, not 1.4 MB of documents",
          "carries": "project-summary",
          "from": "editor-window",
          "ms": 30,
          "to": "editor-server",
          "via": "get-rpc-project"
        },
        {
          "action": "Answer from the index: no file read or parsed unless its mtime or size moved",
          "carries": "file-summary",
          "from": "editor-server",
          "ms": 5,
          "to": "project-index"
        }
      ]
    },
    "play-a-flow-across-designs": {
      "id": "play-a-flow-across-designs",
      "index": "a3",
      "name": "Play a flow across designs",
      "steps": [
        {
          "action": "Ask for the full documents of the designs the flow reaches, first steps first",
          "carries": "snapshot",
          "from": "editor-window",
          "ms": 120,
          "to": "editor-server",
          "via": "get-rpc-documents"
        },
        {
          "action": "Hand over the parsed documents it already holds",
          "from": "editor-server",
          "ms": 5,
          "to": "project-index"
        },
        {
          "action": "While a step plays, prefetch the next design's",
          "async": true,
          "from": "editor-window",
          "ms": 60,
          "to": "editor-server",
          "via": "get-rpc-documents"
        }
      ]
    },
    "switch-to-another-design": {
      "id": "switch-to-another-design",
      "index": "a0",
      "name": "Switch to another design",
      "steps": [
        {
          "action": "Ask for shop's snapshot since the version cached in the tab (drawn from the cache meanwhile)",
          "carries": "snapshot",
          "from": "editor-window",
          "ifFails": "The cached one stays, read-only, with a retry",
          "ms": 40,
          "to": "editor-server",
          "via": "get-rpc-snapshot"
        },
        {
          "action": "Take shop's warm Workspace, or open it",
          "from": "editor-server",
          "ms": 5,
          "to": "workspace-pool"
        },
        {
          "action": "Check the versions of shop's imports; rebuild its system only if one moved",
          "from": "workspace-pool",
          "ms": 5,
          "to": "project-index"
        },
        {
          "action": "Answer 304, or the snapshot; the tab moves its event stream to shop without reloading",
          "carries": "snapshot",
          "from": "editor-server",
          "ms": 30,
          "to": "editor-window",
          "via": "get-rpc-snapshot"
        }
      ]
    }
  }
}
