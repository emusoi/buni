  "parts": {
    "design-files": {
      "id": "design-files",
      "ifDown": "A design that can't be read shows as broken in the lists, with why; the others keep working",
      "index": "a5",
      "kind": "store",
      "name": "Design files",
      "purpose": "The .buni files of the project folder: a core, its sections, their attachments.",
      "tech": "Disk"
    },
    "editor-server": {
      "id": "editor-server",
      "index": "a1",
      "kind": "service",
      "name": "Editor server",
      "purpose": "buni open: answers the window over RPC and pushes edits over one event stream; one per project folder.",
      "tech": "Bun.serve"
    },
    "editor-window": {
      "id": "editor-window",
      "index": "a0",
      "kind": "client",
      "name": "Editor window",
      "purpose": "The design open in a browser tab or the desktop app: canvas, sidebar, Play. Today it reloads on every switch and asks for the whole project as full documents.",
      "tech": "React, one tab per design"
    },
    "file-watcher": {
      "id": "file-watcher",
      "ifDown": "The index reconciles by stat every few seconds until it is back; edits made in the editor still update it directly",
      "index": "a4",
      "kind": "queue",
      "name": "File watcher",
      "purpose": "Says which design files changed on disk (an agent, git, another tool), so nothing rereads what has not.",
      "tech": "fs.watch, debounced"
    },
    "project-index": {
      "id": "project-index",
      "index": "a3",
      "kind": "cache",
      "name": "Project index",
      "purpose": "Every design of the folder parsed once, kept by path, mtime and size: a light summary for lists and pickers, the full document only when asked.",
      "tech": "In-process map"
    },
    "workspace-pool": {
      "id": "workspace-pool",
      "index": "a2",
      "kind": "service",
      "name": "Workspace pool",
      "purpose": "Open designs kept warm in memory, one Workspace each, imports resolved; the least recently used go past a budget.",
      "tech": "In-process, LRU"
    }
  },
  "phases": {
    "1-index": {
      "goal": "One server-side project index and a summaries RPC replace home() everywhere in the editor",
      "id": "1-index",
      "index": "a0",
      "name": "1 · Index"
    },
    "2-incremental": {
      "goal": "Imports invalidated by version and systems memoised; a file watcher keeps the index and open tabs fresh",
      "id": "2-incremental",
      "index": "a1",
      "name": "2 · Incremental"
    },
    "3-one-tab": {
      "goal": "Switching designs inside the tab, from a snapshot cache, with prefetch",
      "id": "3-one-tab",
      "index": "a2",
      "name": "3 · One tab"
    },
    "4-lazy": {
      "goal": "Full documents only for Play and flows; thumbnails as cached pictures",
      "id": "4-lazy",
      "index": "a3",
      "name": "4 · Lazy"
    }
  },
