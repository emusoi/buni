  "questions": {
    "q-how-does-the-index": {
      "about": [
        "project-index",
        "file-watcher"
      ],
      "at": "2026-10-16T22:50:39.701Z",
      "by": "claude",
      "chosen": "Watch directories, reconcile on failure",
      "id": "q-how-does-the-index",
      "index": "a1",
      "kind": "question",
      "options": [
        {
          "cons": "Grows with the folder; still a syscall per design per request",
          "name": "Stat every file on each request",
          "pros": "No watcher to fail"
        },
        {
          "cons": "fs.watch differs by platform; needs debounce and a full reconcile when it drops",
          "name": "Watch directories, reconcile on failure",
          "pros": "Catches atomic replaces, renames and deletes; the server's own writes update the index directly"
        }
      ],
      "status": "decided",
      "text": "How does the index learn a design changed?"
    },
    "q-how-should-the-tab": {
      "about": [
        "editor-window",
        "switch-to-another-design"
      ],
      "at": "2026-10-16T22:50:37.431Z",
      "by": "claude",
      "chosen": "Switch in the tab, from a snapshot cache",
      "id": "q-how-should-the-tab",
      "index": "a0",
      "kind": "question",
      "options": [
        {
          "cons": "Pays the bundle, the snapshot and a whole first render on every switch; selection and view lost",
          "name": "Keep the full reload, cache on the server",
          "pros": "Smallest change; nothing in the window's state to get wrong"
        },
        {
          "cons": "The window must settle edits, drop stale answers and re-point its stream cleanly",
          "name": "Switch in the tab, from a snapshot cache",
          "pros": "Instant for designs seen before; selection and view kept per design; one stream re-pointed"
        }
      ],
      "status": "decided",
      "text": "How should the tab switch to another design?"
    },
    "q-what-do-lists-and": {
      "about": [
        "file-summary",
        "get-rpc-project"
      ],
      "at": "2026-10-16T22:50:40.500Z",
      "by": "claude",
      "chosen": "Summaries; full documents on demand",
      "id": "q-what-do-lists-and",
      "index": "a2",
      "kind": "question",
      "options": [
        {
          "cons": "1.4 MB per call for this repo; parsed on every open",
          "name": "Full documents, as home() sends today",
          "pros": "Anything can be computed in the window"
        },
        {
          "cons": "A new RPC and a summary shape to keep in step with the format",
          "name": "Summaries; full documents on demand",
          "pros": "A few KB per design; the counts (component uses) computed once on the server"
        }
      ],
      "status": "decided",
      "text": "What do lists and pickers get from the server?"
    }
  },
