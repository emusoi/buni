    },
    "editor-server-subscribes-file-watcher": {
      "from": "editor-server",
      "id": "editor-server-subscribes-file-watcher",
      "kind": "subscribes",
      "note": "To push ProjectDelta to open tabs and refresh open designs whose imports changed",
      "to": "file-watcher"
    },
    "editor-window-calls-editor-server": {
      "carries": [
        "project-summary",
        "snapshot",
        "project-delta"
      ],
      "failure": {
        "fallback": "The cached snapshot stays on screen, read-only, with a retry",
        "timeoutMs": 5000
      },
      "from": "editor-window",
      "id": "editor-window-calls-editor-server",
      "kind": "calls",
      "note": "RPC for one file at a time; one event stream per tab for edits and project deltas",
      "to": "editor-server"
    },
    "project-index-reads-design-files": {
      "from": "project-index",
      "id": "project-index-reads-design-files",
      "kind": "reads",
      "note": "Stat first; read and parse only a file whose mtime or size moved",
      "to": "design-files"
    },
    "project-index-subscribes-file-watcher": {
      "from": "project-index",
      "id": "project-index-subscribes-file-watcher",
      "kind": "subscribes",
      "note": "Directory events, debounced; a full reconcile when the watcher drops",
      "to": "file-watcher"
    },
    "workspace-pool-reads-project-index": {
      "from": "workspace-pool",
      "id": "workspace-pool-reads-project-index",
      "kind": "reads",
      "note": "Imported documents and their versions: a system is rebuilt only when one changed",
      "to": "project-index"
    },
    "workspace-pool-writes-design-files": {
      "from": "workspace-pool",
      "id": "workspace-pool-writes-design-files",
      "kind": "writes",
      "note": "Edits, written whole and atomically; the index is told directly, not by the watcher",
      "to": "design-files"
    }
  },
