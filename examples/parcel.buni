  "questions": {
    "q-who-pays-for-the": {
      "about": [],
      "at": "2026-10-03T16:20:37.502Z",
      "by": "claude-code",
      "chosen": "Merchant always",
      "id": "q-who-pays-for-the",
      "index": "a0",
      "kind": "question",
      "options": [
        {
          "cons": "Merchant pays for every return, even abuse",
          "name": "Merchant always",
          "pros": "Simplest for buyers; most returns"
        },
        {
          "cons": "Buyers drop off; needs a clear price before they commit",
          "name": "Deducted from the refund",
          "pros": "Merchant cost is zero"
        }
      ],
      "status": "decided",
      "text": "Who pays for the return label?"
    }
  },
