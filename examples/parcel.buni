  "decisions": {
    "28397325": {
      "at": "2026-10-03T17:39:03.626Z",
      "by": "you",
      "id": "28397325",
      "text": "POST /returns/{id}/reject: Email the reason the merchant gave; buyers asked why"
    },
    "30ca200d": {
      "at": "2026-10-03T18:30:16.436Z",
      "by": "you",
      "id": "30ca200d",
      "text": "PATCH /store: No cache on store settings; buyers see changes on their next lookup"
    },
    "38981d3b": {
      "at": "2026-10-03T16:31:23.216Z",
      "by": "claude-code",
      "id": "38981d3b",
      "text": "Order lookups are rate limited in Postgres (lookup_attempts, keyed ip:{ip} and order:{number}, one-hour windows); no Redis until load says so."
    },
    "450253eb": {
      "at": "2026-10-03T16:20:36.980Z",
      "by": "claude-code",
      "id": "450253eb",
      "text": "One service (Returns API, TypeScript) and one Postgres for v1; split only for a reason we can name."
    },
    "5494893f": {
      "at": "2026-10-03T16:20:37.155Z",
      "by": "claude-code",
      "id": "5494893f",
      "text": "Refunds go through a queue and are idempotent on the return id: at-least-once delivery, handlers safe to repeat."
    },
    "6a1f7e2c": {
      "at": "2026-10-03T16:27:49.593Z",
      "by": "claude-code",
      "id": "6a1f7e2c",
      "text": "Who pays for the return label? → Merchant always: v1 optimises for buyers finishing the return; stores in our range see few abusive returns, and a deduction can come later as a store setting."
    },
    "7d9f282c": {
      "at": "2026-10-03T16:20:37.327Z",
      "by": "claude-code",
      "id": "7d9f282c",
      "text": "Buyers never get an account: a short-lived signed link proves they own the order."
    },
    "d3b14c1b": {
      "at": "2026-10-03T16:31:22.844Z",
      "by": "claude-code",
      "id": "d3b14c1b",
      "text": "The buyer never waits on the carrier for more than 400 ms: past that, POST /returns answers without the label and it is booked and emailed after. Keeps the 500 ms page budget."
    }
  },
  "endpoints": {
    "get-returns": {
      "access": {
        "roles": [
          "merchant"
        ],
        "rule": "Only their store's returns",
        "who": "roles"
      },
      "emits": [],
      "id": "get-returns",
      "index": "a3",
      "method": "GET",
      "path": "/returns",
      "reads": [
        "returns"
      ],
      "request": [
        {
          "name": "status",
          "optional": true,
          "type": "ReturnStatus"
        },
        {
          "name": "cursor",
          "optional": true,
          "type": "string"
        }
      ],
      "response": [],
      "responseShape": "return-page",
      "service": "returns-api",
      "summary": "The store's returns, newest first, filtered by status.",
      "writes": []
    },
    "get-returns-id": {
      "access": {
        "roles": [
          "buyer",
          "merchant"
        ],
        "rule": "The buyer with its token, or the store it belongs to",
        "who": "roles"
      },
      "emits": [],
      "errors": [
        {
          "code": "404",
          "when": "No such return, or not yours"
        }
      ],
      "id": "get-returns-id",
      "index": "a2",
      "method": "GET",
      "path": "/returns/{id}",
      "reads": [
        "returns",
        "return-items"
      ],
      "request": [],
      "response": [],
      "responseShape": "return",
      "service": "returns-api",
      "summary": "One return, for its buyer or its store.",
      "writes": []
    },
    "get-shopify-callback": {
      "access": {
        "rule": "Only with Shopify's HMAC signature and the signed state from /store/shopify/reconnect, for that store",
        "who": "public"
      },
      "emits": [
        "refund-requested"
      ],
      "errors": [
        {
          "code": "400",
          "when": "The signature or the state does not match the one we issued"
        }
      ],
      "id": "get-shopify-callback",
      "index": "aA",
      "method": "GET",
      "path": "/shopify/callback",
      "reads": [
        "refunds"
      ],
      "request": [
        {
          "name": "code",
          "type": "string"
        },
        {
          "name": "shop",
          "type": "string"
        },
        {
          "name": "state",
          "type": "string"
        },
        {
          "name": "hmac",
          "type": "string"
        }
      ],
      "response": [],
      "service": "returns-api",
      "summary": "Where Shopify sends the merchant back after approving Parcel: saves the new token, marks the store connected, re-queues every refund held while it was not, and redirects to Settings.",
      "writes": [
        "stores"
      ]
    },
    "get-store": {
      "access": {
        "roles": [
          "merchant"
        ],
        "rule": "Only their own store",
        "who": "roles"
      },
      "emits": [],
      "id": "get-store",
      "index": "a7",
      "method": "GET",
      "path": "/store",
      "reads": [
        "stores"
      ],
      "request": [],
      "response": [],
      "responseShape": "store-settings",
      "service": "returns-api",
      "summary": "The signed-in merchant's store settings.",
      "writes": []
    },
    "patch-store": {
      "access": {
        "roles": [
          "merchant"
        ],
        "rule": "Only their own store",
        "who": "roles"
      },
      "emits": [],
      "errors": [
        {
          "code": "422",
          "when": "The window is under 14 days (a buyer's legal minimum) or over 365, or the colour is not a hex colour"
        }
      ],
      "id": "patch-store",
      "index": "a8",
      "method": "PATCH",
      "path": "/store",
      "reads": [],
      "request": [],
      "requestShape": "store-settings-change",
      "response": [],
      "responseShape": "store-settings",
      "service": "returns-api",
      "summary": "Change the return policy, branding or notifications; only what is sent changes. Buyers see it on their next lookup: nothing caches the store.",
      "writes": [
        "stores"
      ]
    },
    "post-orders-lookup": {
      "access": {
        "rule": "Rate limited to 10 tries an hour per IP and per order number, counted in lookup_attempts",
        "who": "public"
      },
      "emits": [],
      "errors": [
        {
          "code": "404",
          "when": "No order has that number and email"
        },
        {
          "code": "410",
          "when": "The return window has closed"
        },
        {
          "code": "429",
          "when": "Ten tries in the last hour for this IP or order number"
        }
      ],
      "id": "post-orders-lookup",
      "index": "a0",
      "method": "POST",
      "path": "/orders/lookup",
      "reads": [
        "stores",
        "returns",
        "return-items"
      ],
      "request": [],
      "requestShape": "order-lookup",
      "response": [],
      "responseShape": "order",
      "service": "returns-api",
      "summary": "Find an order by its number and email, say which lines can go back and why not, and hand back a short-lived token to return it.",
      "writes": [
        "lookup-attempts"
      ]
    },
    "post-returns": {
      "access": {
        "roles": [
          "buyer"
        ],
        "rule": "Only the order the return token was issued for",
        "who": "roles"
      },
      "emits": [
        "label-requested"
      ],
      "errors": [
        {
          "code": "401",
          "when": "The return token expired; look the order up again"
        },
        {
          "code": "409",
          "when": "These items are already being returned"
        },
        {
          "code": "422",
          "when": "An item is not returnable"
        }
      ],
      "id": "post-returns",
      "index": "a1",
      "method": "POST",
      "path": "/returns",
      "reads": [],
      "request": [],
      "requestShape": "return-request",
      "response": [],
      "responseShape": "return",
      "service": "returns-api",
      "summary": "Start a return for the chosen items and book its label, waiting at most 400 ms for the carrier.",
      "writes": [
        "returns",
        "return-items"
      ]
    },
    "post-returns-id-receive": {
      "access": {
        "roles": [
          "merchant"
        ],
        "rule": "Only their store's returns",
        "who": "roles"
      },
      "emits": [],
      "errors": [
        {
          "code": "409",
          "when": "Already received or refunded"
        }
      ],
      "id": "post-returns-id-receive",
      "index": "a4",
      "method": "POST",
      "path": "/returns/{id}/receive",
      "reads": [],
      "request": [],
      "response": [],
      "responseShape": "return",
      "service": "returns-api",
      "summary": "Mark the parcel received.",
      "writes": [
        "returns"
      ]
    },
    "post-returns-id-refund": {
      "access": {
        "roles": [
          "merchant"
        ],
        "rule": "Only their store's returns",
        "who": "roles"
      },
      "emits": [
        "refund-requested"
      ],
      "errors": [
        {
          "code": "409",
          "when": "Already refunded or refunding"
        },
        {
          "code": "422",
          "when": "Not received yet, or the amount is more than the items cost"
        }
      ],
      "id": "post-returns-id-refund",
      "index": "a5",
      "method": "POST",
      "path": "/returns/{id}/refund",
      "reads": [],
      "request": [
        {
          "name": "amount",
          "optional": true,
          "type": "Money"
        }
      ],
      "response": [],
      "responseShape": "return",
      "service": "returns-api",
      "summary": "Approve the refund, in full or in part; the worker pays it.",
      "writes": [
        "returns",
        "refunds"
      ]
    },
    "post-returns-id-reject": {
      "access": {
        "roles": [
          "merchant"
        ],
        "rule": "Only their store's returns",
        "who": "roles"
      },
      "emits": [
        "return-rejected"
      ],
      "errors": [
        {
          "code": "409",
          "when": "Already refunded"
        }
      ],
      "id": "post-returns-id-reject",
      "index": "a6",
      "method": "POST",
      "path": "/returns/{id}/reject",
      "reads": [],
      "request": [
        {
          "name": "reason",
          "type": "string"
        }
      ],
      "response": [],
      "responseShape": "return",
      "service": "returns-api",
      "summary": "Turn a return down; the worker emails the buyer the reason.",
      "writes": [
        "returns"
      ]
    },
    "post-store-shopify-reconnect": {
      "access": {
        "roles": [
          "merchant"
        ],
        "rule": "Only their own store",
        "who": "roles"
      },
      "emits": [],
      "id": "post-store-shopify-reconnect",
      "index": "a9",
      "method": "POST",
      "path": "/store/shopify/reconnect",
      "reads": [
        "stores"
      ],
      "request": [],
      "response": [
        {
          "name": "url",
          "type": "string"
        }
      ],
      "service": "returns-api",
      "summary": "Hand back Shopify's approval URL with a signed state naming the store; Shopify returns the merchant to GET /shopify/callback, which finishes the job.",
      "writes": []
    }
  },
