  "parts": {
    "buyer-portal": {
      "id": "buyer-portal",
      "index": "a0",
      "kind": "client",
      "name": "Buyer portal",
      "purpose": "Where a buyer finds their order and starts a return, on a phone, without an account.",
      "tech": "Next.js 15"
    },
    "main-database": {
      "id": "main-database",
      "ifDown": "Buyers see \"Returns are paused for a moment, try again in a few minutes\"; nothing is accepted half-way.",
      "index": "a4",
      "kind": "store",
      "name": "Main database",
      "purpose": "Returns, their items and every refund attempt.",
      "tech": "Postgres 16"
    },
    "merchant-dashboard": {
      "id": "merchant-dashboard",
      "index": "a1",
      "kind": "client",
      "name": "Merchant dashboard",
      "purpose": "Where a merchant sees the returns queue, marks parcels received and refunds.",
      "tech": "Next.js 15"
    },
    "refund-jobs": {
      "id": "refund-jobs",
      "ifDown": "Clicks still record the decision; jobs are re-sent from the database when the queue is back.",
      "index": "a5",
      "kind": "queue",
      "name": "Jobs",
      "purpose": "Work that happens after the response: paying refunds, and booking labels the carrier was too slow for.",
      "tech": "SQS standard queue"
    },
    "refund-worker": {
      "api": "none",
      "id": "refund-worker",
      "index": "a3",
      "kind": "service",
      "name": "Worker",
      "purpose": "Does the work after the response, once per job: pays refunds through Shopify, books late labels, and emails the buyer (label, refund sent, rejected with the reason). Holds refunds while the store needs reconnecting.",
      "tech": "TypeScript on Node 22"
    },
    "resend": {
      "id": "resend",
      "ifDown": "Emails retry for a day; the portal still shows the label.",
      "index": "a8",
      "kind": "external",
      "name": "Resend",
      "purpose": "Sends the buyer their label and refund emails.",
      "tech": "Resend"
    },
    "returns-api": {
      "id": "returns-api",
      "index": "a2",
      "kind": "service",
      "name": "Returns API",
      "purpose": "Owns returns: looks up orders, books labels, records decisions and queues refunds.",
      "tech": "TypeScript on Node 22, Hono"
    },
    "shippo": {
      "id": "shippo",
      "ifDown": "The return is still accepted; the label is emailed when Shippo is back.",
      "index": "a7",
      "kind": "external",
      "name": "Shippo",
      "purpose": "Books the return label the buyer prints.",
      "tech": "Shippo API"
    },
    "shopify": {
      "id": "shopify",
      "ifDown": "Buyers cannot find orders; the portal says the store is unreachable. Refunds wait in the queue.",
      "index": "a6",
      "kind": "external",
      "name": "Shopify",
      "purpose": "The store's orders, and where refunds are paid.",
      "tech": "Shopify Admin API 2025-07",
      "x": 316,
      "y": 232
    }
  },
