      "was": "{\"access\":{\"rule\":\"Only with Shopify's HMAC signature and the signed state from /store/shopify/reconnect, for that store\",\"who\":\"public\"},\"emits\":[\"refund-requested\"],\"errors\":[{\"code\":\"400\",\"when\":\"The signature or the state does not match the one we issued\"}],\"id\":\"get-shopify-callback\",\"method\":\"GET\",\"path\":\"/shopify/callback\",\"reads\":[\"refunds\"],\"request\":[{\"name\":\"code\",\"type\":\"string\"},{\"name\":\"shop\",\"type\":\"string\"},{\"name\":\"state\",\"type\":\"string\"},{\"name\":\"hmac\",\"type\":\"string\"}],\"service\":\"returns-api\",\"summary\":\"Where Shopify sends the merchant back after approving Parcel: saves the new token, marks the store connected, re-queues every refund held while it was not, and redirects to Settings.\",\"writes\":[\"stores\"]}"
