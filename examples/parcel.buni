  "journeys": {
    "4b75faa5": {
      "flow": "09598114",
      "id": "4b75faa5",
      "lanes": [
        "Doing",
        "Thinking",
        "Feeling",
        "Risk"
      ],
      "steps": [
        {
          "cells": {
            "Doing": "Taps the link in the order email, types the order number",
            "Feeling": "Wary; returns are usually a chore",
            "Risk": "Typo in the email: the 404 must say which field to check, not just 'not found'",
            "Thinking": "Do I need an account? Where is my order number?"
          },
          "confidence": 4,
          "evidence": [],
          "page": "2e00677a"
        },
        {
          "cells": {
            "Doing": "Ticks the shirt, picks Wrong size",
            "Feeling": "Hopeful, a bit unsure about the money",
            "Risk": "The refund total and 'label paid by the shop' must be visible before the button",
            "Thinking": "Do I get the full £48 back? Who pays postage?"
          },
          "confidence": 3,
          "evidence": [],
          "page": "50094e02"
        },
        {
          "cells": {
            "Doing": "Saves the QR code, heads to a drop-off",
            "Feeling": "Relieved; it took under two minutes",
            "Risk": "If the label was slow, the page must say it is coming by email, not show a blank code",
            "Thinking": "When will I see the money?"
          },
          "confidence": 5,
          "evidence": [],
          "page": "bf6a55ad"
        }
      ]
    },
    "584e1d99": {
      "flow": "bfc5cd57",
      "id": "584e1d99",
      "lanes": [
        "Doing",
        "Thinking",
        "Feeling",
        "Risk"
      ],
      "steps": [
        {
          "cells": {
            "Doing": "Opens Parcel from the morning email; sees refunds paused",
            "Feeling": "Worried; money and customers are involved",
            "Risk": "Must say nothing is lost and how many refunds wait, before asking them to act",
            "Thinking": "Did buyers get their money? Did I break something?"
          },
          "confidence": 2,
          "evidence": [],
          "page": "2a14cd1a"
        },
        {
          "cells": {
            "Doing": "Approves Parcel in Shopify, lands back on Settings",
            "Feeling": "Relieved once it says connected",
            "Risk": "Show the held refunds going out, or the merchant refunds again by hand in Shopify",
            "Thinking": "Is it fixed? Did the waiting refunds go?"
          },
          "confidence": 4,
          "evidence": [],
          "page": "a26b64eb"
        }
      ]
    }
  },
  "links": {
    "buyer-portal-calls-returns-api": {
      "carries": [
