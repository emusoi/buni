    "refund-worker-calls-shopify": {
      "carries": [
        "refund-job"
      ],
      "failure": {
        "fallback": "Leave the job on the queue; alert after 5 tries",
        "idempotencyKey": "return id",
        "retries": 5,
        "timeoutMs": 10000
      },
      "from": "refund-worker",
      "id": "refund-worker-calls-shopify",
      "kind": "calls",
      "note": "Create the refund on the order. A 401 means Shopify refused our token: set stores.shopify_status to needs_reconnect and hold the job, it is not a failure to retry",
      "to": "shopify"
    },
    "refund-worker-subscribes-refund-jobs": {
