  "traces": {
    "find-my-order": {
      "id": "find-my-order",
      "index": "a0",
      "name": "Find my order",
      "steps": [
        {
          "action": "POST /orders/lookup",
          "carries": "order-lookup",
          "from": "buyer-portal",
          "ifFails": "Couldn’t reach the shop; try again",
          "ms": 30,
          "to": "returns-api",
          "via": "post-orders-lookup"
        },
        {
          "action": "orders(query: name + email)",
          "carries": "order",
          "from": "returns-api",
          "ifFails": "The store is unreachable right now",
          "ms": 350,
          "to": "shopify"
        }
      ]
    },
    "refund-a-return": {
      "id": "refund-a-return",
      "index": "a2",
      "name": "Refund a return",
      "steps": [
        {
          "action": "POST /returns/{id}/refund",
          "from": "merchant-dashboard",
          "ms": 30,
          "to": "returns-api",
          "via": "post-returns-id-refund"
        },
        {
          "action": "insert refunds (unique return_id), status refunding",
          "from": "returns-api",
          "ifFails": "Already refunding: shown as such, nothing queued twice",
          "ms": 20,
          "to": "main-database"
        },
        {
          "action": "publish refund.requested",
          "carries": "refund-job",
          "from": "returns-api",
          "ms": 20,
          "to": "refund-jobs",
          "via": "refund-requested"
        },
        {
          "action": "deliver refund.requested",
          "async": true,
          "carries": "refund-job",
          "from": "refund-jobs",
          "to": "refund-worker",
          "via": "refund-requested"
        },
        {
          "action": "refundCreate",
          "async": true,
          "carries": "refund-job",
          "from": "refund-worker",
          "to": "shopify"
        },
        {
          "action": "update refunds, returns: refunded",
          "async": true,
          "from": "refund-worker",
          "to": "main-database"
        },
        {
          "action": "email: refund sent",
          "async": true,
          "from": "refund-worker",
          "to": "resend"
        }
      ]
    },
    "start-a-return": {
      "id": "start-a-return",
      "index": "a1",
      "name": "Start a return",
      "steps": [
        {
          "action": "POST /returns",
          "carries": "return-request",
          "from": "buyer-portal",
          "ms": 30,
          "to": "returns-api",
          "via": "post-returns"
        },
        {
          "action": "insert returns, return_items",
          "carries": "return",
          "from": "returns-api",
          "ifFails": "Nothing is saved; the buyer can submit again",
          "ms": 20,
          "to": "main-database"
        },
        {
          "action": "create return label, waiting at most 400 ms",
          "carries": "label",
          "from": "returns-api",
          "ifFails": "Return started; the page says the label is on its way by email",
          "ms": 400,
          "to": "shippo"
        },
        {
          "action": "email the label",
          "async": true,
          "carries": "label",
          "from": "returns-api",
          "to": "resend"
        }
      ]
    }
  }
}
