{
  "name": "buni",
  "version": "0.3.3",
  "description": "Design tools for agents and people: the .buni design format, its tools, a CLI and an MCP server.",
  "keywords": [
    "design",
    "design-tools",
    "mcp",
    "agents",
    "ai",
    "cli",
    "ui",
    "system-design"
  ],
  "author": "emusoi (https://github.com/emusoi)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./examples/*": "./examples/*",
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "bin": {
    "buni": "src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emusoi/buni.git"
  },
  "homepage": "https://buni.emusoi.app",
  "bugs": "https://github.com/emusoi/buni/issues",
  "engines": {
    "bun": ">=1.3"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "examples",
    "README.md",
    "FORMAT.md",
    "LICENSE",
    "CHANGELOG.md",
    "FONT-LICENSES.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "fonts": "bun scripts/fonts.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@napi-rs/keyring": "^2.1.0",
    "fractional-indexing": "^4.0.0",
    "lucide": "^1.47.0",
    "parse5": "^8.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@types/bun": "^1.4.2",
    "typescript": "5"
  }
}
